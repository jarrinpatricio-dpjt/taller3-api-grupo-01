{
    "openapi": "3.1.0",
    "info": {
        "title": "API de Solicitudes de Citas",
        "description": "API que expone de forma segura el servicio de solicitudes de citas de gastroenterología de un sistema heredado. Taller 3 - Gestión de Servicios en la Nube.",
        "version": "1.0.0"
    },
    "paths": {
        "/": {
            "get": {
                "tags": [
                    "Estado"
                ],
                "summary": "Estado Servicio",
                "description": "Verifica que la API está en línea (health check).",
                "operationId": "estado_servicio__get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/token": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Obtener Token",
                "description": "Recibe usuario y contraseña y devuelve un token JWT.",
                "operationId": "obtener_token_api_v1_token_post",
                "requestBody": {
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/Body_obtener_token_api_v1_token_post"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Token"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/solicitudes": {
            "get": {
                "tags": [
                    "Solicitudes de Citas"
                ],
                "summary": "Listar Solicitudes",
                "description": "Lista las solicitudes del usuario autenticado.",
                "operationId": "listar_solicitudes_api_v1_solicitudes_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "items": {
                                        "$ref": "#/components/schemas/Solicitud"
                                    },
                                    "type": "array",
                                    "title": "Response Listar Solicitudes Api V1 Solicitudes Get"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "OAuth2PasswordBearer": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Solicitudes de Citas"
                ],
                "summary": "Registrar Solicitud",
                "description": "Registra un nuevo solicitud a nombre del usuario autenticado.",
                "operationId": "registrar_solicitud_api_v1_solicitudes_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SolicitudNueva"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Solicitud"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "OAuth2PasswordBearer": []
                    }
                ]
            }
        },
        "/api/v1/solicitudes/{solicitud_id}": {
            "get": {
                "tags": [
                    "Solicitudes de Citas"
                ],
                "summary": "Consultar Solicitud",
                "description": "Consulta el estado de una solicitud del usuario autenticado.",
                "operationId": "consultar_solicitud_api_v1_solicitudes__solicitud_id__get",
                "security": [
                    {
                        "OAuth2PasswordBearer": []
                    }
                ],
                "parameters": [
                    {
                        "name": "solicitud_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "title": "Solicitud Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Solicitud"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Solicitud no encontrada"
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Body_obtener_token_api_v1_token_post": {
                "properties": {
                    "grant_type": {
                        "anyOf": [
                            {
                                "type": "string",
                                "pattern": "^password$"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Grant Type"
                    },
                    "username": {
                        "type": "string",
                        "title": "Username"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "title": "Password"
                    },
                    "scope": {
                        "type": "string",
                        "title": "Scope",
                        "default": ""
                    },
                    "client_id": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Client Id"
                    },
                    "client_secret": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "format": "password",
                        "title": "Client Secret"
                    }
                },
                "type": "object",
                "required": [
                    "username",
                    "password"
                ],
                "title": "Body_obtener_token_api_v1_token_post"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "Solicitud": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Id"
                    },
                    "tipo": {
                        "type": "string",
                        "title": "Tipo"
                    },
                    "estado": {
                        "type": "string",
                        "title": "Estado"
                    },
                    "fecha": {
                        "type": "string",
                        "format": "date",
                        "title": "Fecha"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "tipo",
                    "estado",
                    "fecha"
                ],
                "title": "Solicitud"
            },
            "SolicitudNueva": {
                "properties": {
                    "tipo": {
                        "type": "string",
                        "maxLength": 100,
                        "minLength": 3,
                        "title": "Tipo",
                        "examples": [
                            "Consulta de gastroenterología"
                        ]
                    }
                },
                "type": "object",
                "required": [
                    "tipo"
                ],
                "title": "SolicitudNueva"
            },
            "Token": {
                "properties": {
                    "access_token": {
                        "type": "string",
                        "title": "Access Token"
                    },
                    "token_type": {
                        "type": "string",
                        "title": "Token Type",
                        "default": "bearer"
                    }
                },
                "type": "object",
                "required": [
                    "access_token"
                ],
                "title": "Token"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        },
        "securitySchemes": {
            "OAuth2PasswordBearer": {
                "type": "oauth2",
                "flows": {
                    "password": {
                        "scopes": {},
                        "tokenUrl": "/api/v1/token"
                    }
                }
            }
        }
    }
}